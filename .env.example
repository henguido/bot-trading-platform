# Plantilla de configuración. Copiar a `.env` y rellenar.
# NUNCA commitear el `.env` real — está ignorado por .gitignore.

# ─────────────────────────────────────────────────────────────
# MODO DE EJECUCIÓN
# ─────────────────────────────────────────────────────────────
# PAPER = simulación, no envía órdenes reales (POR DEFECTO si se omite)
# LIVE  = envía órdenes REALES a Binance con dinero real
TRADING_MODE=PAPER

# Segunda confirmación, obligatoria para que LIVE surta efecto.
# Dejar vacío mantiene el sistema en PAPER aunque TRADING_MODE=LIVE.
# Valor exacto requerido: yes-i-understand-the-risk
ALLOW_LIVE_TRADING=

# ─────────────────────────────────────────────────────────────
# Base de datos
# ─────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./backend/app.db

# ─────────────────────────────────────────────────────────────
# Seguridad
# ─────────────────────────────────────────────────────────────
# OBLIGATORIA. No tiene valor por defecto: si falta, la aplicacion NO arranca.
# Generar una clave aleatoria propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Se rechazan valores de ejemplo conocidos (dev-secret-key, supersecret, ...).
SECRET_KEY=

# ─────────────────────────────────────────────────────────────
# Exchange / brokers
# ─────────────────────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_API_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_FEED=iex

# ─────────────────────────────────────────────────────────────
# IA y noticias
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-08-06
CRYPTO_PANIC_API_KEY=
NEWSAPI_KEY=

# ─────────────────────────────────────────────────────────────
# Parámetros del bot
# ─────────────────────────────────────────────────────────────
INITIAL_CAPITAL_USD=20
RISK_PER_TRADE=0.1
WAIT_TIME=14400
# NOTA: MAX_DAILY_LOSS está declarado pero AÚN NO LO LEE NINGÚN CÓDIGO.
MAX_DAILY_LOSS=
