# Plantilla de configuración. Copiar a `.env` y rellenar.
# NUNCA commitear el `.env` real — está ignorado por .gitignore.

# ─────────────────────────────────────────────────────────────
# MODO DE EJECUCIÓN
# ─────────────────────────────────────────────────────────────
# PAPER = simulación, no envía órdenes reales (POR DEFECTO si se omite)
# LIVE  = envía órdenes REALES a Binance con dinero real
TRADING_MODE=PAPER

# Segunda confirmación, obligatoria para que LIVE surta efecto.
# Dejar vacío mantiene el sistema en PAPER aunque TRADING_MODE=LIVE.
# Valor exacto requerido: yes-i-understand-the-risk
ALLOW_LIVE_TRADING=

# ─────────────────────────────────────────────────────────────
# ENTORNO
# ─────────────────────────────────────────────────────────────
# development (por defecto) | test | production
APP_ENV=development

# Origenes web autorizados, separados por coma. En production es obligatorio.
CORS_ORIGINS=http://localhost:5173

# ─────────────────────────────────────────────────────────────
# Base de datos
# ─────────────────────────────────────────────────────────────
# En development, si se omite se usa la SQLite local de abajo.
# En production es OBLIGATORIA y la aporta el entorno del servicio (Render),
# NUNCA este archivo ni el .env local.
DATABASE_URL=sqlite:///./backend/app.db

# Fallo seguro: en development, apuntar DATABASE_URL a un host REMOTO aborta el
# arranque salvo que se autorice aqui deliberadamente. Abrir el proyecto en
# local no debe conectar en silencio a produccion.
PERMITIR_BD_REMOTA_EN_DESARROLLO=false

# ─────────────────────────────────────────────────────────────
# Seguridad
# ─────────────────────────────────────────────────────────────
# OBLIGATORIA. No tiene valor por defecto: si falta, la aplicacion NO arranca.
# Generar una clave aleatoria propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Se rechazan valores de ejemplo conocidos (dev-secret-key, supersecret, ...).
SECRET_KEY=

# ─────────────────────────────────────────────────────────────
# Exchange / brokers
# ─────────────────────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_API_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_FEED=iex

# ─────────────────────────────────────────────────────────────
# IA y noticias
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# GPT (compatibilidad actual) | SAFE_NO_TRADE (sin llamadas IA ni compras nuevas)
DECISION_ENGINE=GPT
OPENAI_MODEL=gpt-4o-2024-08-06
CRYPTO_PANIC_API_KEY=
NEWSAPI_KEY=

# ─────────────────────────────────────────────────────────────
# Parámetros del bot
# ─────────────────────────────────────────────────────────────
# Capital del libro PAPER. Unidad: USDT. Numero positivo.
INITIAL_CAPITAL_USD=500

# Tiempo entre ciclos de analisis. Unidad: SEGUNDOS. Rango 60 .. 604800.
WAIT_TIME=14400

# Vigencia del token de acceso. Unidad: MINUTOS. Rango 1 .. 1440.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─────────────────────────────────────────────────────────────
# GESTION DE RIESGO  (motor determinista)
# Todas se leen del entorno y se validan al arrancar.
# ─────────────────────────────────────────────────────────────
# Tope duro por operacion individual. Unidad: USDT. Default: 20
MONTO_MAXIMO_USDT=20

# Fraccion del capital disponible asignable a UNA operacion. Unidad: 0..1.
# OJO: NO es "riesgo por operacion". Sin stop loss no existe el calculo
# clasico riesgo/distancia-al-stop. Es un limite de ASIGNACION. Default: 0.02
LIMITE_ASIGNACION_POR_OPERACION=0.02
# Alias historico aceptado por compatibilidad: RISK_PER_TRADE

# Perdida REALIZADA maxima por dia de riesgo antes del kill switch.
# Unidad: USDT, valor positivo. Default: 20
# (alias historico aceptado: MAX_DAILY_LOSS, cuya unidad era ambigua)
# Perdida REALIZADA maxima por dia de riesgo. Unidad: USDT ABSOLUTOS.
# En PAPER se admite el default (20). En LIVE es OBLIGATORIA: sin ella el
# arranque falla. La antigua MAX_DAILY_LOSS esta OBSOLETA y se ignora, porque
# su unidad nunca estuvo definida.
MAX_DAILY_LOSS_USDT=20

# Exposicion maxima acumulada, valorada A COSTE. Unidad: USDT.
MAX_EXPOSICION_TOTAL_USDT=100
MAX_EXPOSICION_POR_ACTIVO_USDT=50

# Zona horaria que define el corte del dia de riesgo (cripto opera 24/7).
RISK_TIMEZONE=America/Costa_Rica
